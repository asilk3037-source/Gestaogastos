# Usada pelo Prisma Client em runtime. Em produção (Vercel/serverless), use o
# pooler da Supabase em modo transação (porta 6543 + pgbouncer=true).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Usada só por `prisma migrate`/`db push`. Em produção, use o pooler em modo
# sessão ou a conexão direta (porta 5432, sem pgbouncer). Em dev local com um
# Postgres comum, pode ser igual ao DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/dbname"
