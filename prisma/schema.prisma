// Sistema de Gestão Financeira Pessoal — modelo de dados
// Baseado na especificação funcional v1.0 (seção 10 — Estrutura de dados sugerida)
// Valores monetários são armazenados em centavos (Int), nunca float, conforme regra técnica (seção 11).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: usada pelo Prisma Client em runtime — pooler em modo
  // transação (porta 6543, pgbouncer=true), recomendado pela Supabase para
  // ambientes serverless como a Vercel.
  url       = env("DATABASE_URL")
  // DIRECT_URL: usada só por `prisma migrate`/`db push` — pooler em modo
  // sessão ou conexão direta (porta 5432), que suporta comandos DDL.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  currency  String   @default("BRL")
  createdAt DateTime @default(now())

  months          Month[]
  categories      Category[]
  paymentMethods  PaymentMethod[]
  installments    Installment[]
  fixedExpenses   FixedExpense[]
  cashEntries     CashEntry[]
  openingBalances OpeningBalance[]
  adjustments     Adjustment[]
  personBalances  PersonBalance[]
  importRecords   ImportRecord[]
  auditLogs       AuditLog[]
}

// Uma competência (mês/ano). Criada sob demanda (virada de mês) — o sistema
// não depende de meses pré-cadastrados; qualquer mês pode ser aberto.
model Month {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  year               Int
  month              Int // 1-12
  netIncomeCents     Int? // renda líquida — nula até ser informada pela usuária
  reserveTargetCents Int       @default(0)
  status             String    @default("open") // open | closed
  closedAt           DateTime?
  createdAt          DateTime  @default(now())

  monthlyLimits  MonthlyLimit[]
  transactions   Transaction[]
  cashEntries    CashEntry[]
  openingBalance OpeningBalance?
  adjustments    Adjustment[]
  personBalances PersonBalance[]

  @@unique([userId, year, month])
}

model Category {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  name              String
  icon              String   @default("tag")
  color             String   @default("#0a84ff")
  defaultLimitCents Int      @default(0)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  monthlyLimits MonthlyLimit[]
  transactions  Transaction[]

  @@unique([userId, name])
}

// Teto de uma categoria em uma competência específica — editável por mês,
// sem afetar meses já fechados (regra técnica, seção 11).
model MonthlyLimit {
  id         String   @id @default(cuid())
  monthId    String
  month      Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  limitCents Int

  @@unique([monthId, categoryId])
}

model PaymentMethod {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String // credito | debito | pix | dinheiro | outro
  cardLast4 String?
  isPrimary Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions  Transaction[]
  installments  Installment[]
  fixedExpenses FixedExpense[]
}

model Transaction {
  id              String         @id @default(cuid())
  monthId         String
  month           Month          @relation(fields: [monthId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  amountCents     Int
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  necessary       Boolean?
  notes           String?
  createdAt       DateTime       @default(now())
}

// Compra parcelada — entidade real (não apenas o total do mês). O sistema
// calcula X/Y, projeta meses futuros e encerra automaticamente após Y/Y.
model Installment {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id])
  description            String
  installmentAmountCents Int
  totalInstallments      Int
  firstYear              Int
  firstMonth             Int
  personalPercentage     Float          @default(1) // 0..1 — ex: Casas Bahia = 0.5
  personName             String? // pessoa que compartilha a despesa (opcional, ex: "Isabel")
  paymentMethodId        String?
  paymentMethod          PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  active                 Boolean        @default(true)
  createdAt              DateTime       @default(now())
}

// Despesa fixa recorrente (aluguel, empréstimo, assinaturas fixas...).
// durationMonths define por quantas competências, a partir da inicial, a
// despesa é cobrada (ex: empréstimo = 4). Deixe null para recorrência indefinida.
model FixedExpense {
  id                 String         @id @default(cuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id])
  name               String
  amountCents        Int
  startYear          Int
  startMonth         Int
  durationMonths     Int? // null = recorrência indefinida (até endYear/endMonth ou para sempre)
  endYear            Int?
  endMonth           Int?
  personalPercentage Float          @default(1)
  personName         String?
  mandatory          Boolean        @default(true) // conta como "compromisso obrigatório"
  paymentMethodId    String?
  paymentMethod      PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Pacote de atualização Setembro/2026 — fluxo de caixa, acertos entre
// pessoas e infraestrutura de importação/auditoria (ver
// docs/pacote-setembro-2026.md e prisma/import-setembro-2026.ts).
// ---------------------------------------------------------------------------

// Entrada de caixa que não é necessariamente renda (salário, reembolso,
// empréstimo recebido, transferência...). `countsAsIncome` decide se ela
// entra nas fórmulas de renda/sobra (lib/finance.ts) — por padrão não conta,
// pois o caso de uso principal (ex.: empréstimo recebido) é caixa, não renda.
model CashEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  monthId        String
  month          Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  type           String // salary | reimbursement | loan_proceeds | transfer | other
  amountCents    Int
  countsAsIncome Boolean  @default(false)
  description    String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())
}

// Saldo de caixa disponível no início de uma competência de implantação —
// nunca tratado como receita (spec CA-S02).
model OpeningBalance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  monthId     String   @unique
  month       Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  amountCents Int
  description String?
  createdAt   DateTime @default(now())
}

// Despesa pontual de uma única competência (ex.: "Empréstimo Amanda",
// "Viagem") — nunca vira recorrência automaticamente; some conforme conta
// gastoTotalMes/totalComprometido daquele mês específico, sem afetar os
// seguintes.
model Adjustment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  monthId     String
  month       Month    @relation(fields: [monthId], references: [id], onDelete: Cascade)
  description String
  amountCents Int
  createdAt   DateTime @default(now())
}

// Acerto de despesas compartilhadas com outra pessoa (ex.: Isabel) numa
// competência. payable = a usuária deve à pessoa; receivable = a parte da
// pessoa em despesas pagas pela usuária; net = payable - receivable,
// calculado com precisão total antes de arredondar (regra UT-011 do
// pacote), nunca a partir dos dois subtotais já arredondados.
model PersonBalance {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  monthId         String
  month           Month     @relation(fields: [monthId], references: [id], onDelete: Cascade)
  person          String
  payableCents    Int
  receivableCents Int
  netCents        Int // positivo = usuária deve pagar; negativo = tem a receber
  description     String?
  status          String    @default("pendente") // pendente | pago
  settledAt       DateTime?
  createdAt       DateTime  @default(now())
}

// Controle de idempotência de importações (pacotes de conciliação/planilha)
// — reexecutar o mesmo importId não duplica registros (CA-S07).
model ImportRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  importId  String   @unique
  hash      String
  status    String   @default("aplicado")
  summary   String?
  createdAt DateTime @default(now())
}

// Trilha de auditoria — importações, exclusões e fechamento/reabertura de
// competência (spec seção 15).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}
